{
  "name": "chatspin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts extension/tests/*.test.ts",
    "test:ai": "node --import tsx tests/evaluate-ai.ts",
    "restore": "node --import tsx server/restore.ts",
    "extension:build": "tsc --noEmit && vite build --config extension/vite.config.ts",
    "extension:package": "npm run extension:build && node extension/package.mjs",
    "test:deployment": "node scripts/verify-backend.mjs"
  },
  "dependencies": {
    "@vercel/functions": "3.6.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "openai": "^6.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  }
}
