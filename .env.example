PORT=3000
APP_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
SESSION_SECRET=replace-with-a-long-random-secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
MODERATOR_IDS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ENABLE_DEMO=true
DATA_FILE=./data/state.json

# Optional Twitch Extension (separate registration from Twitch OAuth app)
EXTENSION_CLIENT_ID=
EXTENSION_SECRET=
EXTENSION_PREVIOUS_SECRET=
EXTENSION_ALLOWED_ORIGINS=
VITE_EXTENSION_API_ORIGIN=

# Hosted multi-channel storage (server-only; never VITE_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Hosted background retries (Vercel cron; server-only)
CRON_SECRET=
