{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cloud.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/extension-api/:path*",
      "destination": "/api/cloud?__chatspin_route=/extension-api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/cloud?__chatspin_route=/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/cloud?__chatspin_route=/api/:path*"
    },
    {
      "source": "/viewer",
      "destination": "/index.html"
    },
    {
      "source": "/obs",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "* * * * *"
    }
  ],
  "env": {
    "NODEJS_HELPERS": "0"
  }
}
